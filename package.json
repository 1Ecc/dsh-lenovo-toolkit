{
  "name": "dsh-plugin-battery-health",
  "version": "0.1.0",
  "description": "Battery health diagnostics for DeepSeek Harness: capacity, cycle count, dual health metrics, an SVG decay-trend chart and the OS battery report, on macOS and Windows.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./battery": "./src/battery.js"
  },
  "files": [
    "src/",
    "cordis.patch.yml",
    ".dsh/skills/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "battery",
    "battery-health",
    "diagnostics",
    "hardware"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Ecc/dsh-plugin.git"
  },
  "homepage": "https://github.com/1Ecc/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/1Ecc/dsh-plugin/issues"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/battery.test.js",
    "sync-skill": "bash scripts/sync-skill.sh"
  }
}
